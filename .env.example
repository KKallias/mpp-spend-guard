# Copy this file to .env and fill in your own values.
# NEVER commit the real .env — it's already in .gitignore.

# Tempo Moderato testnet — agent wallet
# Use a THROWAWAY testnet key only. Never a key that holds real funds.
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
AGENT_WALLET_PRIVATE_KEY=
AGENT_WALLET_ADDRESS=

# SpendGuard limits, in the challenge's minor units (raw token units).
# The pathUSD test token has 6 decimals, so 100000 = $0.10.
# These defaults sit just above the mpp.dev/api/ping/paid price ($0.10) so
# scripts/run-testnet-session.js has one request allowed and one blocked.
SPEND_GUARD_PER_REQUEST_CAP_MINOR=200000
SPEND_GUARD_SESSION_CAP_MINOR=1000000
SPEND_GUARD_MAX_REQUESTS_PER_WINDOW=30
SPEND_GUARD_WINDOW_MS=60000
